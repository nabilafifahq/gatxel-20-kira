{
  "name": "kira",
  "private": true,
  "version": "0.1.0",
  "description": "Kira, website belajar Math, English, dan Science untuk keluarga, dijalankan di server rumah.",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @kira/web dev",
    "worker:dev": "pnpm --filter @kira/worker dev",
    "build": "pnpm --filter @kira/web build && pnpm --filter @kira/worker build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint . --max-warnings=0 && node scripts/check-copy.mjs",
    "lint:copy": "node scripts/check-copy.mjs",
    "test": "vitest run --project core --project content --project figures --project web --project worker",
    "test:db": "vitest run --project db --project web-db",
    "test:all": "vitest run",
    "content:check": "tsx packages/content/scripts/check.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "tsx packages/db/scripts/seed.ts",
    "admin": "tsx packages/db/scripts/admin.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
