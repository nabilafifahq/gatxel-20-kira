<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bar sistem transparan diatur enableEdgeToEdge() di MainActivity. -->
    <style name="Theme.Kira" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kira_bg</item>
        <item name="android:colorPrimary">@color/kira_math</item>
        <item name="android:colorAccent">@color/kira_math</item>
        <item name="android:textColorPrimary">@color/kira_fg</item>
        <item name="android:textColorSecondary">@color/kira_fg_muted</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="KiraScreen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/kira_bg</item>
        <item name="android:fillViewport">true</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="KiraContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/screen_padding</item>
    </style>

    <style name="KiraTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/kira_fg</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="KiraBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/kira_fg</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="KiraDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/kira_fg_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="KiraLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textColor">@color/kira_fg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KiraError">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/kira_danger</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="KiraInput" parent="android:Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/input_field</item>
        <item name="android:textColor">@color/kira_fg</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="KiraButton" parent="android:Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="KiraButtonPrimary" parent="KiraButton">
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/kira_surface</item>
    </style>

    <style name="KiraButtonSecondary" parent="KiraButton">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/kira_fg</item>
    </style>
</resources>
