{
  "name": "@kira/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker Kira: antrean job AI, impor PDF, kotak keluar email, laporan mingguan, dan retensi data.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kira/content": "workspace:*",
    "@kira/core": "workspace:*",
    "@kira/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.0.16",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
