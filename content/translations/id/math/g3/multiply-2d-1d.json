{
 "entries": {
  "fb0bb290aefc0cc675e3": {
   "en": "To work out 23 × 4, split 23 into tens and ones.",
   "id": "Untuk menghitung 23 × 4, pisahkan 23 menjadi puluhan dan satuan."
  },
  "0d8389edc874b52eb613": {
   "en": "Multiply the tens by 4.",
   "id": "Kalikan puluhannya dengan 4."
  },
  "92338c5b4e95b80b3f95": {
   "en": "Multiply the ones by 4.",
   "id": "Kalikan satuannya dengan 4."
  },
  "febbf2933e5f1e87ae0d": {
   "en": "A grid keeps the parts tidy. Add the two parts.",
   "id": "Kotak-kotak membuat bagian-bagiannya rapi. Jumlahkan kedua bagian itu."
  },
  "e993930885f4f7056d7d": {
   "en": "30 × 3 = 90 and 6 × 3 = 18. 90 + 18 = 108.",
   "id": "30 × 3 = 90 dan 6 × 3 = 18. 90 + 18 = 108."
  },
  "5827d2c445efcefbfa0e": {
   "en": "20 × 5 = 100 and 4 × 5 = 20. 100 + 20 = 120 crayons.",
   "id": "20 × 5 = 100 dan 4 × 5 = 20. 100 + 20 = 120 krayon."
  },
  "c1fa226d2517521c1995": {
   "en": "Split 23 into 20 and 3. 20 × 4 = 80 and 3 × 4 = 12. 80 + 12 = 92.",
   "id": "Pecah 23 menjadi 20 dan 3. 20 × 4 = 80 dan 3 × 4 = 12. 80 + 12 = 92."
  },
  "6ae9cbbd597c06fbb3d0": {
   "en": "Split 34 into 30 and 4. 30 × 3 = 90 and 4 × 3 = 12. 90 + 12 = 102, not 112.",
   "id": "Pecah 34 menjadi 30 dan 4. 30 × 3 = 90 dan 4 × 3 = 12. 90 + 12 = 102, bukan 112."
  }
 }
}
