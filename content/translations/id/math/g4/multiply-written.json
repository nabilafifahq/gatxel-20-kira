{
 "entries": {
  "cc430c4eadc808d36f8b": {
   "en": "To multiply 243 × 4, split 243 into hundreds, tens and ones.",
   "id": "Untuk menghitung 243 × 4, pecah 243 menjadi ratusan, puluhan, dan satuan."
  },
  "0c997326acb2517ac5fc": {
   "en": "Multiply each part by 4.",
   "id": "Kalikan setiap bagian dengan 4."
  },
  "b0ea7f3ed42670017feb": {
   "en": "Add the parts together.",
   "id": "Jumlahkan semua bagiannya."
  },
  "c212a516b16de6c9bfc8": {
   "en": "Estimate to check. 243 is about 250, and 250 × 4 = 1,000.",
   "id": "Perkirakan untuk memeriksa. 243 kira-kira 250, dan 250 × 4 = 1,000."
  },
  "5488fec9d296730bea23": {
   "en": "100 × 3 = 300, 50 × 3 = 150 and 6 × 3 = 18. 300 + 150 + 18 = 468.",
   "id": "100 × 3 = 300, 50 × 3 = 150, dan 6 × 3 = 18. 300 + 150 + 18 = 468."
  },
  "7c311db1d3ead0801210": {
   "en": "40 × 6 = 240 and 8 × 6 = 48. 240 + 48 = 288 people.",
   "id": "40 × 6 = 240 dan 8 × 6 = 48. 240 + 48 = 288 orang."
  },
  "f23a3ea9ed66f38a6bcd": {
   "en": "300 × 6 = 1,800, 40 × 6 = 240 and 7 × 6 = 42. Adding gives 2,082 pencils.",
   "id": "300 × 6 = 1,800, 40 × 6 = 240, dan 7 × 6 = 42. Kalau dijumlahkan, hasilnya 2,082 pensil."
  },
  "0e89b6c4469e874ec52b": {
   "en": "8 × 4,000 = 32,000 and 8 × 750 = 6,000. The total is Rp38.000.",
   "id": "8 × 4,000 = 32,000 dan 8 × 750 = 6,000. Jumlahnya Rp38.000."
  },
  "bd47f76a0a94dbe2763e": {
   "en": "30 × 3 = 90 and 4 × 3 = 12. 90 + 12 = 102.",
   "id": "30 × 3 = 90 dan 4 × 3 = 12. 90 + 12 = 102."
  },
  "9be1227fbedbcfd59048": {
   "en": "200 × 4 = 800 and 15 × 4 = 60. 800 + 60 = 860, not 840.",
   "id": "200 × 4 = 800 dan 15 × 4 = 60. 800 + 60 = 860, bukan 840."
  },
  "694064d120fe9bdb4b28": {
   "en": "100 × 5 = 500 and 26 × 5 = 130. 500 + 130 = 630.",
   "id": "100 × 5 = 500 dan 26 × 5 = 130. 500 + 130 = 630."
  }
 }
