{
  "skill": "m5.add-subtract-fractions",
  "title": "Adding and subtracting fractions",
  "steps": [
    {
      "say": "When the denominators are the same, add the numerators. The denominator stays the same.",
      "show": "2/7 + 3/7 = 5/7",
      "figure": {
        "kind": "fraction",
        "shape": "bar",
        "parts": 7,
        "shaded": 5,
        "label": "5/7",
        "alt": "A bar split into 7 equal parts with 5 parts shaded."
      }
    },
    {
      "say": "Sevenths stay sevenths, so do not add the denominators.",
      "show": "2/7 + 3/7 is not 5/14"
    },
    {
      "say": "If one denominator is a multiple of the other, change one fraction first.",
      "show": "1/2 + 3/8 = 4/8 + 3/8 = 7/8",
      "figure": {
        "kind": "fraction",
        "shape": "bar",
        "parts": 8,
        "shaded": 7,
        "label": "7/8",
        "alt": "A bar split into 8 equal parts with 7 parts shaded."
      }
    },
    {
      "say": "Subtraction works the same way. Make the denominators match, then subtract the numerators.",
      "show": "5/6 − 1/3 = 5/6 − 2/6 = 3/6"
    },
    {
      "say": "Simplify the answer if you can.",
      "show": "3/6 = 1/2"
    },
    {
      "say": "If the answer is more than one whole, you can write it as a mixed number.",
      "show": "3/4 + 2/4 = 5/4 = 1 1/4"
    }
  ],
