{
  "skill": "m5.add-subtract-decimals",
  "title": "Adding and subtracting decimals",
  "steps": [
    {
      "say": "Line up the decimal points so tenths sit under tenths. Fill any gaps with zeros.",
      "show": "4.75 + 2.80",
      "figure": {
        "kind": "table",
        "caption": "4.75 + 2.8",
        "head": [
          "Ones",
          "Tenths",
          "Hundredths"
        ],
        "rows": [
          [
            "4",
            "7",
            "5"
          ],
          [
            "2",
            "8",
            "0"
          ]
        ],
        "alt": "A place value chart with 4.75 above 2.80, lined up by place."
      }
    },
    {
      "say": "Add from the right, as with whole numbers. Carry when a column makes 10 or more.",
      "show": "5 + 0 = 5, 7 + 8 = 15, 4 + 2 + 1 = 7"
    },
    {
      "say": "Put the decimal point in the answer under the other points.",
      "show": "4.75 + 2.8 = 7.55"
    },
    {
      "say": "To subtract, line up the points the same way. Exchange when the top digit is too small.",
      "show": "6.30 − 2.47 = 3.83"
    },
    {
      "say": "For mental sums, use pairs that make 1. 0.35 + 0.65 = 1.",
      "show": "0.35 + 0.65 = 1",
      "figure": {
        "kind": "numberline",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "labels": [
          0,
          0.5,
          1
        ],
        "jumps": [
          {
            "from": 0,
            "to": 0.35,
            "label": "0.35"
          },
          {
            "from": 0.35,
            "to": 1,
            "label": "0.65"
          }
        ],
        "alt": "A number line from 0 to 1 with a jump of 0.35 from 0 and a jump of 0.65 to 1."
      }
    },
    {
      "say": "Measures use decimals too. If 1.25 m is cut from a 3.5 m ribbon, 2.25 m is left.",
      "show": "3.50 − 1.25 = 2.25"
    }
  ],
  "check": [
