{
  "skill": "m5.compare-fractions",
  "title": "Comparing fractions and mixed numbers",
  "steps": [
    {
      "say": "When the denominators are the same, compare the numerators. 5/8 is more than 3/8.",
      "show": "5/8 > 3/8",
      "figure": {
        "kind": "fraction",
        "shape": "bar",
        "parts": 8,
        "shaded": 5,
        "label": "5/8",
        "alt": "A bar split into 8 equal parts with 5 parts shaded."
      }
    },
    {
      "say": "When the numerators are the same, a bigger denominator means smaller pieces.",
      "show": "1/3 > 1/5"
    },
    {
      "say": "Otherwise, make the denominators the same. 2/3 and 3/4 can both become twelfths.",
      "show": "2/3 = 8/12 and 3/4 = 9/12, so 3/4 > 2/3"
    },
    {
      "say": "An improper fraction has a numerator bigger than its denominator. It is more than one whole.",
      "show": "7/4 = 1 3/4",
      "figure": {
        "kind": "numberline",
        "min": 0,
        "max": 2,
        "step": 0.25,
        "labels": [
          0,
          1,
          2
        ],
        "marks": [
          {
            "at": 1.75,
            "label": "7/4"
          }
        ],
        "alt": "A number line from 0 to 2 in quarters with 7/4 marked between 1 and 2."
      }
    },
    {
      "say": "To change 7/4 to a mixed number, divide 7 by 4. That makes 1 whole with 3 quarters left.",
      "show": "7 ÷ 4 = 1 r 3, so 7/4 = 1 3/4"
    },
    {
      "say": "To change back, multiply the whole number by the denominator, then add the numerator.",
      "show": "2 1/3 = (2 × 3 + 1)/3 = 7/3"
    }
  ],
