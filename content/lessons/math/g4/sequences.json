  "steps": [
    {
      "say": "A sequence follows a rule. Look at the difference between terms next to each other.",
      "figure": {
        "kind": "sequence",
        "items": [
          "7",
          "11",
          "15",
          "19",
          null
        ],
        "alt": "A sequence: 7, 11, 15, 19, then a gap."
      }
    },
    {
      "say": "Each term is 4 more than the one before. The rule is add 4.",
      "show": "11 - 7 = 4"
    },
    {
      "say": "Use the rule to find the next term.",
      "show": "19 + 4 = 23"
    },
    {
      "say": "Sequences can go down, and they can cross zero.",
      "show": "6, 3, 0, -3, -6"
    },
    {
      "say": "For a missing term in the middle, use the rule from the term before it.",
      "show": "25, ___, 41: 25 + 8 = 33"
    }
  ],
