  "title": "Fractions of amounts and measures",
  "steps": [
    {
      "say": "To find 3/5 of 40, first find 1/5 of 40.",
      "show": "40 ÷ 5 = 8"
    },
    {
      "say": "Then take 3 of those parts.",
      "figure": {
        "kind": "fraction",
        "shape": "bar",
        "parts": 5,
        "shaded": 3,
        "alt": "A bar for 40 split into 5 equal parts of 8, with 3 parts shaded."
      },
      "show": "3 × 8 = 24, so 3/5 of 40 = 24"
    },
    {
      "say": "It works for money too.",
      "show": "1/4 of Rp20.000 = Rp20.000 ÷ 4 = Rp5.000"
    },
    {
      "say": "It works for measures as well. Change to a smaller unit first if it helps.",
      "show": "1/2 of 1 m = 100 cm ÷ 2 = 50 cm"
    }
  ],
