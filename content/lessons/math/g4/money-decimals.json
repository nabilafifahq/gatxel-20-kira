  "title": "Money with a decimal point",
  "steps": [
    {
      "say": "Some countries use dollars and cents. 100 cents make $1.",
      "show": "$1 = 100 cents"
    },
    {
      "say": "$3.45 means 3 dollars and 45 cents.",
      "show": "$3.45 = 345 cents"
    },
    {
      "say": "To add prices, add the dollars and the cents, or change both to cents.",
      "figure": {
        "kind": "table",
        "caption": "Snack bar",
        "head": [
          "Item",
          "Price"
        ],
        "rows": [
          [
            "Juice",
            "$1.85"
          ],
          [
            "Sandwich",
            "$2.30"
          ],
          [
            "Banana",
            "$0.65"
          ]
        ],
        "alt": "Snack bar prices: juice $1.85, sandwich $2.30, banana $0.65."
      },
      "show": "$2.30 + $1.85 = $4.15"
    },
    {
      "say": "To find change, count up to the next whole dollar first.",
      "show": "$2.65 to $3.00 is 35 cents"
    },
    {
      "say": "Then count on to the money paid.",
      "show": "$3.00 to $5.00 is $2, so the change is $2.35"
    }
  ],
