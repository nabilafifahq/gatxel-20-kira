{
  "skill": "m4.coordinates",
  "title": "Coordinates and translation",
  "steps": [
    {
      "say": "Coordinates tell you where a point is. Go across first, then go up.",
      "figure": {
        "kind": "coordinates",
        "size": 8,
        "points": [
          {
            "x": 3,
            "y": 2,
            "label": "A"
          }
        ],
        "alt": "A coordinate grid with point A 3 across and 2 up."
      }
    },
    {
      "say": "A is 3 across and 2 up, so A is at (3, 2).",
      "show": "(3, 2)"
    },
    {
      "say": "The order matters. (2, 3) is a different point.",
      "figure": {
        "kind": "coordinates",
        "size": 8,
        "points": [
          {
            "x": 3,
            "y": 2,
            "label": "A"
          },
          {
            "x": 2,
            "y": 3,
            "label": "B"
          }
        ],
        "alt": "A coordinate grid with A at (3, 2) and B at (2, 3)."
      },
      "show": "A (3, 2) and B (2, 3)"
    },
    {
      "say": "A translation slides a point without turning it. Move A 3 right and 2 up.",
      "figure": {
        "kind": "coordinates",
        "size": 8,
        "points": [
          {
            "x": 3,
            "y": 2,
            "label": "A"
          },
          {
            "x": 6,
            "y": 4,
            "label": "C"
          }
        ],
        "alt": "A coordinate grid with A at (3, 2) and C at (6, 4)."
      },
      "show": "(3 + 3, 2 + 2) = (6, 4)"
    }
  ],
