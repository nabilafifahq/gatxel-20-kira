    },
    {
      "say": "For mixed units, change the big part, then add the small part.",
      "show": "2 kg 350 g = 2,000 g + 350 g = 2,350 g"
    },
    {
      "say": "Decimals work too. 1.5 l is 1 litre and half a litre.",
      "show": "1.5 l = 1,500 ml"
    }
