{
  "skill": "m6.compare-fractions",
  "title": "Simplifying and comparing fractions",
  "steps": [
    {
      "say": "To simplify, divide the numerator and denominator by their highest common factor.",
      "show": "24/36: the HCF is 12, so 24/36 = 2/3"
    },
    {
      "say": "To compare fractions, give them a common denominator. Use a common multiple of the denominators.",
      "show": "5/6 and 7/9: common denominator 18"
    },
    {
      "say": "5/6 = 15/18 and 7/9 = 14/18, so 5/6 is bigger.",
      "show": "15/18 > 14/18"
    },
    {
      "say": "A number line helps you see the order.",
      "show": "3/8 < 1/2 < 3/4",
      "figure": {
        "kind": "numberline",
        "min": 0,
        "max": 1,
        "step": 0.125,
        "labels": [
          0,
          1
        ],
        "marks": [
          {
            "at": 0.375,
            "label": "3/8"
          },
          {
            "at": 0.5,
            "label": "1/2"
          },
          {
            "at": 0.75,
            "label": "3/4"
          }
        ],
        "alt": "A number line from 0 to 1 in eighths with 3/8, 1/2 and 3/4 marked."
      }
    },
    {
      "say": "One half is a useful benchmark. Compare each fraction with one half first.",
      "show": "3/7 < 1/2 < 4/7"
    }
  ],
