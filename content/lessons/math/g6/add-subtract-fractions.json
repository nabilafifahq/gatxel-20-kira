  "title": "Adding and subtracting fractions and mixed numbers",
  "steps": [
    {
      "say": "To add fractions with different denominators, find a common denominator first.",
      "show": "2/3 + 1/4 = 8/12 + 3/12"
    },
    {
      "say": "Then add the numerators and keep the denominator.",
      "show": "8/12 + 3/12 = 11/12",
      "figure": {
        "kind": "fraction",
        "shape": "bar",
        "parts": 12,
        "shaded": 11,
        "label": "11/12",
        "alt": "A bar split into 12 equal parts with 11 parts shaded."
      }
    },
    {
      "say": "For mixed numbers, add the whole numbers, then add the fractions.",
      "show": "2 1/2 + 1 2/5 = 3 + 5/10 + 4/10 = 3 9/10"
    },
    {
      "say": "If the fractions make more than one whole, carry the whole over.",
      "show": "1 3/4 + 2 1/2 = 3 + 5/4 = 4 1/4",
      "figure": {
        "kind": "numberline",
        "min": 0,
        "max": 5,
