{
  "skill": "m6.order-of-operations",
  "title": "Order of operations",
  "steps": [
    {
      "say": "When a calculation has more than one operation, the order matters. Brackets come first.",
      "show": "(4 + 6) × 3 = 10 × 3 = 30"
    },
    {
      "say": "After brackets, multiply and divide. Then add and subtract.",
      "show": "4 + 6 × 3 = 4 + 18 = 22"
    },
    {
      "say": "Multiplication and division have equal priority. Work them from left to right.",
      "show": "24 ÷ 4 × 2 = 6 × 2 = 12"
    },
    {
      "say": "Addition and subtraction also go from left to right.",
      "show": "15 − 6 + 2 = 9 + 2 = 11"
    },
    {
      "say": "So the order is brackets, then multiply and divide, then add and subtract.",
      "show": "Brackets, × and ÷, + and −",
      "figure": {
        "kind": "table",
        "head": [
          "Order",
          "What to do"
        ],
        "rows": [
          [
            "1st",
            "Brackets"
          ],
          [
            "2nd",
            "× and ÷, left to right"
          ],
          [
            "3rd",
            "+ and −, left to right"
          ]
        ],
        "alt": "A table of the order of operations: brackets first, then multiply and divide, then add and subtract."
      }
    }
  ],
