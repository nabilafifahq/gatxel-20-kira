{
  "skill": "m6.multiply-divide-fractions",
  "title": "Multiplying and dividing fractions",
  "steps": [
    {
      "say": "To multiply a fraction by a whole number, multiply the numerator.",
      "show": "2/5 × 3 = 6/5 = 1 1/5",
      "figure": {
        "kind": "fraction",
        "shape": "bar",
        "parts": 5,
        "shaded": 2,
        "label": "2/5",
        "alt": "A bar split into 5 equal parts with 2 parts shaded."
      }
    },
    {
      "say": "It is the same as adding the fraction again and again.",
      "show": "2/5 + 2/5 + 2/5 = 6/5"
    },
    {
      "say": "To divide a fraction by a whole number, multiply the denominator.",
      "show": "3/4 ÷ 2 = 3/8"
    },
    {
      "say": "Picture it. Half of 3 quarters is 3 eighths.",
      "show": "3/4 ÷ 2 = 3/8",
      "figure": {
        "kind": "fraction",
        "shape": "bar",
        "parts": 8,
        "shaded": 3,
        "label": "3/8",
        "alt": "A bar split into 8 equal parts with 3 parts shaded."
      }
    },
    {
      "say": "If the numerator divides exactly, you can divide it instead.",
      "show": "6/7 ÷ 3 = 2/7"
    },
    {
      "say": "Fractions of amounts use the same ideas. To find 3/8 of 40, divide by 8, then multiply by 3.",
      "show": "40 ÷ 8 × 3 = 15"
    }
  ],
