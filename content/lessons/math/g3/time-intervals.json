  "steps": [
    {
      "say": "A film starts at 2:15 and ends at 3:30. Count on from the start time.",
      "figure": {
        "kind": "clock",
        "h": 2,
        "m": 15,
        "alt": "A clock showing quarter past 2."
      }
    },
    {
      "say": "First count on to the next o'clock.",
      "show": "2:15 to 3:00 is 45 minutes"
    },
    {
      "say": "Then count on to the end time.",
      "show": "3:00 to 3:30 is 30 minutes"
    },
    {
      "say": "Add the parts. 75 minutes is 1 hour and 15 minutes.",
      "show": "45 + 30 = 75"
    },
