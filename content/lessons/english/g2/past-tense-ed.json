{
  "skill": "e2.past-tense-ed",
  "title": "Past tense with -ed",
  "steps": [
    {
      "say": "We use the past tense for things that already happened.",
      "show": "Yesterday I played."
    },
    {
      "say": "Most verbs add -ed.",
      "show": "play, played / jump, jumped"
    },
    {
      "say": "If the verb ends in e, just add d.",
      "show": "smile, smiled / bake, baked"
    },
    {
      "say": "Short words with one vowel double the last letter.",
      "show": "hop, hopped / stop, stopped"
    },
    {
      "say": "If the verb ends in a consonant and y, change the y to i and add -ed.",
      "show": "cry, cried / carry, carried"
    }
  ],
