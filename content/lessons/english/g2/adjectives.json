    {
      "say": "Add -er to compare two things.",
      "show": "tall, taller"
    },
    {
      "say": "Add -est to compare more than two things.",
      "show": "tall, taller, tallest"
    },
    {
      "say": "Some words change before the ending. Big becomes bigger, and happy becomes happier.",
      "show": "big, bigger / happy, happier"
    }
