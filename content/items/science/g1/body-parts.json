    {
      "id": "s1.body-parts.001", "skill": "s1.body-parts", "type": "mcq", "difficulty": 1,
      "prompt": "Which body part do we use to walk?",
      "options": [
        { "text": "ears", "why": "Ears help us hear. They do not help us walk." },
        { "text": "legs" },
        { "text": "elbows", "why": "Elbows help our arms bend." }
      ],
      "answer": 1,
      "hints": ["Think about what moves when you walk.", "Stand up and take a step. What moves?", "March on the spot and notice which parts lift up."],
      "explanation": "We use our legs and feet to walk, run and jump."
    },
    {
      "id": "s1.body-parts.002", "skill": "s1.body-parts", "type": "match", "difficulty": 1,
      "prompt": "Match each body part to what it helps us do.",
      "pairs": [["teeth", "chew food"], ["legs", "walk and run"], ["hands", "hold things"], ["neck", "turn the head"]],
      "hints": ["Think about using each body part.", "Do the easy ones first.", "Take a bite of food in your mind. Which part chews?"],
      "explanation": "Teeth chew food, legs help us walk and run, hands hold things and the neck lets us turn our head."
    },
    {
      "id": "s1.body-parts.003", "skill": "s1.body-parts", "type": "numeric", "difficulty": 1,
      "prompt": "How many eyes do most people have?",
      "figure": { "kind": "icons", "items": [{ "icon": "eye", "label": "eye" }], "alt": "A picture of an eye." },
      "answer": 2,
      "hints": ["Look at a face in a mirror.", "Count one eye, then the other.", "Point to your left eye and say 1."],
      "explanation": "Most people have 2 eyes, one on each side of the nose."
    },
    {
      "id": "s1.body-parts.004", "skill": "s1.body-parts", "type": "mcq", "difficulty": 2,
      "prompt": "Which body part is between your hand and your shoulder?",
      "options": [
        { "text": "knee", "why": "Your knee is in the middle of your leg." },
        { "text": "ankle", "why": "Your ankle joins your foot to your leg." },
        { "text": "elbow" }
      ],
      "answer": 2,
      "hints": ["Touch your shoulder, then slide down to your hand.", "Find the place where your arm bends.", "Bend your arm and look at the pointy part."],
      "explanation": "The elbow is in the middle of the arm, between the shoulder and the hand. It lets the arm bend."
    },
    {
      "id": "s1.body-parts.005", "skill": "s1.body-parts", "type": "mcq", "difficulty": 2,
      "prompt": "Your leg bends in the middle. What is that part called?",
      "options": [
        { "text": "knee" },
        { "text": "wrist", "why": "Your wrist joins your hand to your arm." },
        { "text": "neck", "why": "Your neck holds up your head." }
      ],
      "answer": 0,
      "hints": ["Sit down and look at your legs.", "Find where your leg bends when you sit.", "Put your hand on the bend in your leg."],
      "explanation": "The knee is in the middle of the leg. It lets the leg bend when we sit, kick or climb."
    },
    {
      "id": "s1.body-parts.006", "skill": "s1.body-parts", "type": "sort", "difficulty": 2,
