    {
      "id": "s1.body-parts.008", "skill": "s1.body-parts", "type": "mcq", "difficulty": 2,
      "prompt": "Where do people wear a watch?",
      "figure": { "kind": "icons", "items": [{ "icon": "clock", "label": "watch" }], "alt": "A watch." },
      "options": [
        { "text": "on the neck", "why": "A necklace goes around the neck. A watch goes on the arm." },
        { "text": "on the wrist" },
        { "text": "on the knee", "why": "The knee is on the leg. A watch goes on the arm." }
      ],
      "answer": 1,
      "hints": ["Picture someone checking the time on a watch.", "Which part of the arm is thin and near the hand?", "Look at where your hand joins your arm."],
      "explanation": "A watch is worn on the wrist. The wrist joins the hand to the arm."
    },
    {
      "id": "s1.body-parts.009", "skill": "s1.body-parts", "type": "multi", "difficulty": 3,
      "prompt": "Choose all the body parts that come in pairs.",
      "options": [
        { "text": "eyes" },
        { "text": "ears" },
        { "text": "nose", "why": "Most people have one nose, in the middle of the face." },
        { "text": "arms" },
        { "text": "mouth", "why": "Most people have one mouth." }
      ],
      "answers": [0, 1, 3],
      "hints": ["A pair means two of the same thing.", "Count each one on your own body.", "Start with your eyes. How many are there?"],
      "explanation": "Eyes, ears and arms come in pairs, one on each side of the body. The nose and mouth are in the middle, and there is one of each."
    },
    {
      "id": "s1.body-parts.010", "skill": "s1.body-parts", "type": "order", "difficulty": 3,
      "prompt": "Order the body parts from the top to the bottom.",
      "items": ["head", "neck", "shoulders", "knees", "ankles", "toes"],
      "hints": ["Start at the very top of your body.", "Touch each part as you go down.", "Put the head first, then find the part just below it."],
      "explanation": "From top to bottom, the order is head, neck, shoulders, knees, ankles and toes."
    },
    {
      "id": "s1.body-parts.011", "skill": "s1.body-parts", "type": "mcq", "difficulty": 4,
      "prompt": "Which body part helps us taste, eat and talk?",
      "figure": { "kind": "icons", "items": [{ "icon": "nose", "label": "nose" }, { "icon": "ear", "label": "ear" }, { "icon": "tongue", "label": "tongue" }], "alt": "Three pictures: a nose, an ear and a tongue." },
      "options": [
        { "text": "nose", "why": "The nose helps us smell and breathe. It does not help us chew." },
        { "text": "ear", "why": "Ears help us hear. They do not help us eat." },
        { "text": "tongue" }
      ],
      "answer": 2,
      "hints": ["Think about what moves in your mouth when you speak.", "Which part is inside your mouth?", "Say la la la slowly. What moves?"],
      "explanation": "The tongue helps us taste food, move it around while we chew and make sounds when we talk.",
      "tags": ["iksc"]
    },
    {
      "id": "s1.body-parts.012", "skill": "s1.body-parts", "type": "mcq", "difficulty": 3,
      "prompt": "Some body parts are inside us. Which one is inside?",
      "options": [
        { "text": "heart" },
        { "text": "elbow", "why": "You can see your elbow on the outside of your arm." },
        { "text": "chin", "why": "Your chin is on the outside, at the bottom of your face." }
      ],
      "answer": 0,
      "hints": ["Think about parts you can feel but not see.", "Put your hand on your chest. What can you feel beating?", "Check each one. Can you see it in a mirror?"],
      "explanation": "The heart is inside the chest. We cannot see it, but we can feel it beating. The elbow and the chin are on the outside."
    },
    {
      "id": "s1.body-parts.013", "skill": "s1.body-parts", "type": "multi", "difficulty": 5,
      "prompt": "Choose all the places where your body can bend.",
      "options": [
        { "text": "elbow" },
        { "text": "nose", "why": "The nose does not bend like a joint." },
        { "text": "knee" },
        { "text": "chin", "why": "The chin does not bend. The jaw below it moves to open the mouth." },
        { "text": "wrist" }
      ],
      "answers": [0, 2, 4],
      "hints": ["A bend lets part of your body fold.", "Gently try moving each part.", "Start with your elbow. Can your arm fold there?"],
      "explanation": "The elbow, the knee and the wrist are joints. Joints are places where the body bends. The nose and the chin do not bend."
