# Kira, contoh variabel lingkungan untuk Docker Compose di server rumah.
# Di Windows: .\deploy\windows\kira.ps1 init membuat .env dari file ini dan mengisi setiap GANTI dengan nilai acak.
# Jangan pernah commit .env. Rahasia yang pernah masuk git harus diganti.
# Satu nilai acak (48 karakter hex) di PowerShell:
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
# atau di WSL/Linux: openssl rand -hex 24

# ---------------------------------------------------------------------------
# Alamat dan rahasia aplikasi

# Alamat https dari `tailscale serve`, tanpa garis miring di akhir. Dipakai untuk passkey dan tautan email.
KIRA_ORIGIN=https://kira-server.example-tailnet.ts.net
KIRA_RP_NAME=Kira
# Minimal 32 karakter acak.
KIRA_SECRET=GANTI_DENGAN_48_KARAKTER_ACAK
# Token sekali pakai untuk halaman /setup saat database masih kosong (minimal 12 karakter).
KIRA_SETUP_TOKEN=GANTI_TOKEN_SETUP
# Rahasia bersama web dan worker untuk /api/internal (minimal 32 karakter).
KIRA_INTERNAL_TOKEN=GANTI_DENGAN_48_KARAKTER_ACAK

# ---------------------------------------------------------------------------
# Database (Postgres 17 di Docker). Hanya huruf dan angka supaya aman di URL koneksi.
POSTGRES_PASSWORD=GANTI_HEX_ACAK
KIRA_OWNER_PASSWORD=GANTI_HEX_ACAK
KIRA_APP_PASSWORD=GANTI_HEX_ACAK
KIRA_AUTH_PASSWORD=GANTI_HEX_ACAK
KIRA_WORKER_PASSWORD=GANTI_HEX_ACAK

# ---------------------------------------------------------------------------
# Folder di Windows. Pakai garis miring biasa. Folder dibuat otomatis.
# Data berkas (rekaman, foto, PDF impor, APK tablet).
KIRA_HOST_DATA=D:/Kira/data
# Cadangan database harian dan mingguan.
KIRA_HOST_BACKUPS=D:/Kira/backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# ---------------------------------------------------------------------------
# Identitas pengelola untuk Kebijakan Privasi dan Ketentuan (wajib diisi sebelum dipakai keluarga lain).
KIRA_LEGAL_NAME=
KIRA_LEGAL_ADDRESS=
KIRA_LEGAL_EMAIL=
KIRA_LEGAL_PHONE=
KIRA_LEGAL_COURT=Jakarta Selatan
KIRA_LEGAL_EFFECTIVE=2026-10-12

# ---------------------------------------------------------------------------
# Email (opsional). Tanpa SMTP, email menunggu di kotak keluar konsol dan tautannya bisa disalin.
# Contoh Gmail dengan App Password: smtps://alamat%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
SMTP_FROM="Kira <kira@example.com>"

# ---------------------------------------------------------------------------
# AI (hanya dipakai worker). Pilih satu provider.
# claude-code: langganan Claude Max lewat Claude Code CLI. Isi token dari `claude setup-token`.
# openai-compatible: ai.gatxel.com atau DeepInfra (isi AI_BASE_URL, AI_API_KEY, AI_MODEL).
# none: semua fitur AI mati, fitur lain tetap jalan.
AI_PROVIDER=claude-code
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL_AUTHOR=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Batas job AI per bulan (jumlah job, karena langganan tidak dihitung per rupiah).
AI_MONTHLY_JOB_LIMIT=400

# ---------------------------------------------------------------------------
# Lain-lain
KIRA_MAX_LEARNERS=10
# Endpoint MCP untuk Claude Code di /api/mcp (token dibuat di konsol, halaman Koneksi Claude).
KIRA_MCP=on
# Cek password terhadap HaveIBeenPwned (k-anonymity). Biarkan on di produksi.
KIRA_HIBP=on

# ---------------------------------------------------------------------------
# Khusus pengembangan tanpa Docker (pnpm dev). Lihat scripts/dev-db.sh env.
# DATABASE_URL_OWNER=postgres://kira_owner:devpass@localhost:54329/kira
# DATABASE_URL_APP=postgres://kira_app:devpass@localhost:54329/kira
# DATABASE_URL_AUTH=postgres://kira_auth:devpass@localhost:54329/kira
# DATABASE_URL_WORKER=postgres://kira_worker:devpass@localhost:54329/kira
# KIRA_DATA_DIR=.kira-local/data
# KIRA_INTERNAL_URL=http://localhost:3000
# CLAUDE_BIN=claude
# PGSSLROOTCERT=

# ---------------------------------------------------------------------------
# Suara bahasa Inggris (Qwen3-TTS, opsional). Tanpa ini Kira memakai suara bawaan tablet.
# Aktifkan: lihat docs/pasang-windows.md bagian "Suara bahasa Inggris (TTS)".
# Alamat layanan tts di jaringan Docker; kosong berarti suara Qwen mati.
TTS_URL=
# Untuk menjalankan layanan: COMPOSE_PROFILES=tts dan, bila ada GPU NVIDIA,
# COMPOSE_FILE=docker-compose.yml;docker-compose.tts-gpu.yml
# COMPOSE_PROFILES=tts
# COMPOSE_FILE=docker-compose.yml;docker-compose.tts-gpu.yml
# auto (GPU bila terlihat, kalau tidak CPU), cuda, atau cpu.
# TTS_DEVICE=auto
# Model dibongkar dari GPU setelah sekian detik tanpa permintaan.
# TTS_IDLE_SECONDS=600
# Model tidak dimuat bila GPU punya memori kosong kurang dari ini (MiB). Melindungi program lain di GPU yang sama.
# TTS_MIN_FREE_MIB=7000
# cpu: bila GPU penuh, klip permintaan dibuat di CPU (lambat). none: dilewati, tablet memakai suara bawaan.
# TTS_OOM_FALLBACK=none
