# Kira, contoh variabel lingkungan. Salin ke .env lalu isi.
# Jangan pernah commit .env. Rahasia yang pernah masuk git harus diganti.

# Alamat publik aplikasi (URL Tailscale serve), dipakai untuk passkey dan tautan email.
KIRA_ORIGIN=https://kira-server.example-tailnet.ts.net
# Nama yang dilihat pengguna saat membuat passkey.
KIRA_RP_NAME=Kira

# Database. Tiga role berbeda, lihat docs/adr/0002-auth-dan-role-database.md
DATABASE_URL_OWNER=postgres://kira_owner:GANTI@db:5432/kira
DATABASE_URL_APP=postgres://kira_app:GANTI@db:5432/kira
DATABASE_URL_AUTH=postgres://kira_auth:GANTI@db:5432/kira
DATABASE_URL_WORKER=postgres://kira_worker:GANTI@db:5432/kira

# Rahasia internal 32 byte acak (openssl rand -base64 32). Untuk token cetak worker dan HMAC.
KIRA_SECRET=GANTI_DENGAN_32_BYTE_ACAK
# Token sekali pakai untuk halaman /setup saat database masih kosong.
KIRA_SETUP_TOKEN=GANTI

# Penyimpanan berkas (audio, foto, PDF). Di Docker dipetakan ke folder Windows.
KIRA_DATA_DIR=/data

# Email (opsional). Tanpa SMTP, email menunggu di kotak keluar konsol.
SMTP_URL=
SMTP_FROM="Kira <kira@example.com>"

# AI. Provider: claude-code (langganan Claude lewat CLI) atau openai-compatible.
AI_PROVIDER=claude-code
# Hasil `claude setup-token` di komputer yang login ke akun Claude Max.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL_AUTHOR=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Untuk ai.gatxel.com atau DeepInfra (OpenAI-compatible).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Batas job AI per bulan (jumlah job, karena langganan tidak dihitung per dolar).
AI_MONTHLY_JOB_LIMIT=400

# Backup harian pg_dump.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
